LOCAL_API_KEY=change-me-to-a-random-string

# Optional: upstream session window (defaults shown).
# Upstream counts one session per request and keeps it alive for ~60 s, so a
# value above 3 per 60 s will hit TM.00001041 unless you add more accounts.
# PROXY_WINDOW_SECONDS=60
# PROXY_MAX_PER_WINDOW=3
# PROXY_MAX_WAIT_SECONDS=120
# PROXY_SESSION_RETRIES=1
# PROXY_RETRY_DELAYS=5,15
# PROXY_MAX_ACTIVE=64
# PROXY_UPSTREAM_TIMEOUT=300